NODE_ENV=development
PORT=4000

# Database
DATABASE_URL="postgresql://admin:password@localhost:5432/cloudmart"

# JWT
JWT_ACCESS_SECRET=your_access_secret_change_in_production
JWT_REFRESH_SECRET=your_refresh_secret_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email (local: log to console, AWS: SES)
EMAIL_FROM=noreply@cloudmart.dev
# AWS_REGION=ap-southeast-1
# SES_SMTP_HOST=email-smtp.ap-southeast-1.amazonaws.com

# S3 (local: save to /uploads, AWS: S3)
UPLOAD_DIR=uploads
# S3_BUCKET=cloudmart-media
# S3_REGION=ap-southeast-1

# Frontend URL (CORS)
CLIENT_URL=http://localhost:3000
